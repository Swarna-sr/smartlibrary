<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/header_gradient">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📚"
                android:textSize="54sp"
                android:gravity="center"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Join Smart Library and start your reading journey"
                android:textSize="14sp"
                android:textColor="#E0F2FE"
                android:gravity="center"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- SIGNUP CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="24dp"
            android:layout_margin="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sign Up"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:gravity="center"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create your account to save, review and share books"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- EMAIL LABEL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#374151"
                android:layout_marginBottom="6dp" />

            <!-- EMAIL INPUT -->
            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Enter your email"
                android:inputType="textEmailAddress"
                android:textSize="15sp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:padding="14dp"
                android:singleLine="true"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="18dp" />

            <!-- PASSWORD LABEL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#374151"
                android:layout_marginBottom="6dp" />

            <!-- PASSWORD INPUT -->
            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Create a password"
                android:inputType="textPassword"
                android:textSize="15sp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:padding="14dp"
                android:singleLine="true"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="24dp" />

            <!-- SIGNUP BUTTON -->
            <Button
                android:id="@+id/signupButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Create Account"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8B5CF6"
                android:layout_marginBottom="14dp" />

            <!-- LOGIN REDIRECT TEXT -->
            <TextView
                android:id="@+id/loginRedirectText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Already have an account? Login"
                android:textSize="14sp"
                android:textColor="#3B82F6"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="10dp" />

        </LinearLayout>

        <!-- INFO CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#EEF2FF"
            android:padding="18dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ What you can do"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#4338CA"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Search books, save favorites, write reviews, follow users, chat with friends and share books."
                android:textSize="14sp"
                android:textColor="#4B5563"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
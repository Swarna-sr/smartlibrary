<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/header_gradient">

            <ImageView
                android:id="@+id/profileAvatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="@drawable/circle_bg"
                android:padding="18dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/profileTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Profile"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center" />

            <TextView
                android:id="@+id/profileSubtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage your Smart Library identity"
                android:textSize="14sp"
                android:textColor="#E0F2FE"
                android:gravity="center"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="22dp"
            android:layout_margin="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Account Details"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6B7280"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/currentEmailText"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="user@gmail.com"
                android:textSize="15sp"
                android:textColor="#374151"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Display Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6B7280"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Enter your name"
                android:textSize="15sp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:padding="14dp"
                android:singleLine="true"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/saveProfileButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Save Profile"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8B5CF6"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/backToHomeButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Back to Home"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3B82F6" />

        </LinearLayout>

        <!-- INFO CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#EEF2FF"
            android:padding="18dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ Profile Tip"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#4338CA"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your display name is used when you submit community reviews for books."
                android:textSize="14sp"
                android:textColor="#4B5563"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>